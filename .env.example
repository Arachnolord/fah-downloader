# ============================================================================
# FAH Media Downloader – Umgebungskonfiguration
# Diese Datei wird von manage.sh aus .env.example erzeugt, wenn .env fehlt.
# Sie liegt AUSSERHALB der Release-ZIP und wird bei Updates NIE ueberschrieben.
# ============================================================================

# WebGUI-Port -- der EINZIGE Port, den dieser Dienst auf dem Host belegt.
# manage.sh sucht bei der Erstinstallation einen freien (echter TCP-Bind-Test)
# und prueft ihn VOR JEDEM Start erneut: haelt ihn inzwischen ein anderer
# Dienst, wird automatisch auf den naechsten freien ausgewichen und dieser
# Wert hier angepasst. Ein Portkonflikt kann den Start also nicht verhindern.
DOWNLOADER_PORT=8080

# Optionaler Start-Admin. Wird nur beim ALLERERSTEN Start angelegt, solange
# noch kein Nutzer existiert. Leer lassen -> Ersteinrichtung ueber die WebGUI.
ADMIN_USER=
ADMIN_PASSWORD=

# Zeitzone im Container.
TZ=Europe/Berlin

# Host-Pfad, der als "freier Zielordner" ins Container-Dateisystem gemountet
# wird (read/write, im Container unter /hostfs). Seit 2.5.1 ist der Standard
# ein Medien-Teilbaum (/volume1) und nicht mehr das ganze Host-Root: der
# Container laeuft als root mit SYS_ADMIN -- mit / als Ziel haette jeder
# angemeldete Nutzer Schreibzugriff auf das komplette NAS gehabt.
# Anpassen auf den Ort, an dem die Medien liegen (z.B. /volume1/medien).
HOSTFS_MOUNT=/volume1

# Optional noch enger: Komma-Liste erlaubter Ordner UNTERHALB von HOSTFS_MOUNT
# (relativ dazu). Nur diese tauchen im Ordner-Browser auf und nur dorthin
# darf geschrieben werden. Leer = der ganze HOSTFS_MOUNT ist waehlbar.
# Beispiel: DOWNLOAD_ROOTS=medien/downloads,video/serien
DOWNLOAD_ROOTS=

# Downloads von Adressen im eigenen Netz (10.x, 192.168.x, 127.x, localhost,
# fd00::/8 ...) werden abgelehnt, damit ueber den Downloader keine internen
# Dienste angesprochen werden koennen. 1 = trotzdem erlauben (z.B. eigener
# Medienserver im Heimnetz als Quelle).
DOWNLOAD_ALLOW_PRIVATE=0

# Wohin die Standard-Downloads auf dem Host geschrieben werden (Bind-Mount).
DOWNLOADS_HOST_PATH=./downloads
